
---

# `.gitignore`

```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Next.js
.next/
out/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
tmp/
temp/

# Uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# Coverage
coverage/

# Cache
.cache/
.parcel-cache/

# Vite
.vite/

# Generated files
*.tmp

# Local database files
*.sqlite
*.sqlite3

# Secrets / credentials
*.pem
*.key

# Environment files
.env
.env.*
!.env.example