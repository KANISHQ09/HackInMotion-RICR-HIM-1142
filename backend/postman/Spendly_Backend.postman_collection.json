{
  "info": {
    "_postman_id": "9f73028c-2ae2-4757-9b47-smartfinance",
    "name": "Smart Finance Backend API",
    "description": "SRS-focused smoke-test collection. Run folders in order: Auth, Transactions, Analytics, Budgets, Goals. Import the Smart Finance Backend Local environment first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date();",
          "pm.environment.set('today', d.toISOString().slice(0, 10));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ((pm.response.headers.get('Content-Type') || '').includes('application/json')) {",
          "  const json = pm.response.json();",
          "  pm.test('response has success flag', () => pm.expect(json).to.have.property('success'));",
          "  pm.test('request succeeded', () => pm.expect(json.success).to.eql(true));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/healthz.json"
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.result && json.result.token) pm.environment.set('authToken', json.result.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.result && json.result.token) pm.environment.set('authToken', json.result.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Create Manual Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.result && json.result.id) pm.environment.set('transactionId', json.result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"description\": \"Zomato dinner\",\n  \"amount\": \"450.00\",\n  \"type\": \"debit\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "Create Income Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"description\": \"Salary August\",\n  \"amount\": \"50000.00\",\n  \"type\": \"credit\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "List Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions"
          }
        },
        {
          "name": "Search Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions?search=zomato&type=debit&category=Food"
          }
        },
        {
          "name": "Update Transaction",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{today}}\",\n  \"description\": \"Zomato dinner updated\",\n  \"amount\": \"475.00\",\n  \"type\": \"debit\",\n  \"category\": \"Food\"\n}"
            },
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          }
        },
        {
          "name": "CSV Import",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/transactions/import"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Summary This Month",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/analytics/summary?period=this_month"
          }
        },
        {
          "name": "Recurring Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/analytics/recurring?period=this_month"
          }
        },
        {
          "name": "Anomalies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/analytics/anomalies?period=this_month"
          }
        },
        {
          "name": "Health Score",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health-score?period=this_month"
          }
        },
        {
          "name": "Recommendations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recommendations?period=this_month"
          }
        }
      ]
    },
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Create Budget",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.result && json.result.id) pm.environment.set('budgetId', json.result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Food\",\n  \"limitAmount\": \"5000.00\",\n  \"period\": \"monthly\"\n}"
            },
            "url": "{{baseUrl}}/api/budgets"
          }
        },
        {
          "name": "List Budgets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/budgets"
          }
        }
      ]
    },
    {
      "name": "Goals",
      "item": [
        {
          "name": "Create Savings Goal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.result && json.result.id) pm.environment.set('goalId', json.result.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Emergency Fund\",\n  \"targetAmount\": \"100000.00\",\n  \"targetDate\": \"2026-12-31\"\n}"
            },
            "url": "{{baseUrl}}/api/goals"
          }
        },
        {
          "name": "List Goals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/goals"
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ]
}
